rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Foto produk hanya boleh di-upload oleh admin yang sudah login.
    match /produk/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Bukti transfer boleh di-upload pelanggan tanpa login.
    // Hanya file gambar maksimal 5 MB yang diizinkan.
    match /bukti-pembayaran/{fileName} {
      allow read: if true;
      allow write: if request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null;
    }

    // Folder lain hanya untuk pengguna yang sudah login.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
